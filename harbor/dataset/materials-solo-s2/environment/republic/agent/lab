#!/usr/bin/env python3
"""`lab`: the research community's toolkit. Thin client for the lab server (standard library only)."""

import argparse
import json
import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from kernel import LAB, call, run_cfg  # noqa: E402

KERNEL = os.path.join(os.path.dirname(os.path.realpath(__file__)), "kernel.py")


def out(status, body):
    print(json.dumps(body, indent=2) if status == 200 else f"ERROR {status}: {body.get('detail', body)}")
    return 0 if status == 200 else 1


def load_json_arg(s):
    if os.path.exists(s):
        with open(s) as f:
            return json.load(f)
    return json.loads(s)


def _reorder_exec(argv):
    """`lab exec DIR --input X=B -- CMD` and `lab exec --input X=B DIR -- CMD` both work."""
    if len(argv) < 2 or argv[1] != "exec" or "--" not in argv:
        return argv
    cut = argv.index("--")
    head, opts, pos = argv[:2], [], []
    i = 2
    while i < cut:
        if argv[i] in ("--input", "--timeout") and i + 1 < cut:
            opts += argv[i:i + 2]
            i += 2
        else:
            pos.append(argv[i])
            i += 1
    return head + opts + pos + argv[cut:]


def main():
    sys.argv = _reorder_exec(sys.argv)
    ap = argparse.ArgumentParser(prog="lab", description="Research community toolkit")
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("help")
    sub.add_parser("guide", help="how to run experiments and publish contributions (formats, test types, example)")
    sub.add_parser("problems", help="list the board")
    sub.add_parser("budget", help="money, time and oracle/dev usage left")
    sub.add_parser("agents", help="who is in the community")
    o = sub.add_parser("oracle", help="run one budgeted experiment: lab oracle ID '<json query>'")
    o.add_argument("pid"); o.add_argument("query")
    e = sub.add_parser("eval", help="exact objective (exact problems) or dev score (budgeted): lab eval ID file.json")
    e.add_argument("pid"); e.add_argument("file")
    s = sub.add_parser("submit", help="final answer; last one counts: lab submit ID file.json --claim VALUE")
    s.add_argument("pid"); s.add_argument("file"); s.add_argument("--claim", type=float, required=True)
    p = sub.add_parser("publish", help="post a preprint")
    p.add_argument("--title", required=True)
    p.add_argument("--body", default="")
    p.add_argument("--body-file")
    p.add_argument("--claim", action="append", default=[], help="PROBLEM:EVAL_ID:VALUE, checked against the eval log")
    p.add_argument("--cite", action="append", default=[], help="preprint id you build on")
    sr = sub.add_parser("search", help="search preprints"); sr.add_argument("query", nargs="?", default="")
    rd = sub.add_parser("read", help="read a preprint"); rd.add_argument("id")
    po = sub.add_parser("post", help="message board"); po.add_argument("text"); po.add_argument("--channel", default="general")
    ib = sub.add_parser("inbox", help="read the message board"); ib.add_argument("--all", action="store_true")
    sp = sub.add_parser("recruit", aliases=["spawn"], help="add a researcher to the community (team runs)")
    sp.add_argument("--role", required=True); sp.add_argument("--brief", default=""); sp.add_argument("--brief-file")
    d = sub.add_parser("done", help="finish your work"); d.add_argument("note", nargs="?", default="")
    # open-ended research
    sub.add_parser("datasets", help="this environment's public datasets (mounted at /data in lab exec)")
    sub.add_parser("schema", help="the artifact schema every contribution must follow")
    pu = sub.add_parser("put", help="store a file or directory as a blob: lab put PATH -> blob id")
    pu.add_argument("path")
    fe = sub.add_parser("fetch", help="download a blob: lab fetch BLOB DEST"); fe.add_argument("blob"); fe.add_argument("dest")
    ex = sub.add_parser("exec", help="server-run execution; only these count as evidence: lab exec DIR -- CMD")
    ex.add_argument("code", help="directory or file with the code (uploaded first)")
    ex.add_argument("--input", action="append", default=[], help="NAME=BLOB, appears at /in/NAME")
    ex.add_argument("--timeout", type=int, default=900)
    ex.add_argument("command", nargs=argparse.REMAINDER)
    co = sub.add_parser("contribute", help="submit a research artifact (JSON following `lab schema`)")
    co.add_argument("file")
    ar = sub.add_parser("artifacts", help="list this community's artifacts"); ar.add_argument("query", nargs="?", default="")
    ar.add_argument("--type", default="")
    sh = sub.add_parser("show", help="read an artifact or an exec: lab show ID"); sh.add_argument("id")
    rn = sub.add_parser("runs", help="list recorded experiments (exec ids, exit codes, metrics): lab runs [--all]")
    rn.add_argument("--all", action="store_true", help="everyone's, not just yours")
    wt = sub.add_parser("wait", help="sleep without using the model until a new message or artifact arrives: lab wait [SECONDS]")
    wt.add_argument("seconds", nargs="?", type=int, default=600)
    bt = sub.add_parser("boot", help="(harness) start the founder and wait for the community")
    bt.add_argument("--model", default="")
    a = ap.parse_args()

    if a.cmd == "guide":
        print(open(os.path.join(LAB, "data", "GUIDE.md")).read())
        return 0
    if a.cmd in (None, "help"):
        ap.print_help()
        return 0
    cfg = run_cfg()
    me = os.environ.get("LAB_AGENT_ID", "founder")

    if a.cmd == "problems":
        return out(*call(cfg, me, "GET", "/problems"))
    if a.cmd == "budget":
        return out(*call(cfg, me, "GET", "/budget"))
    if a.cmd == "agents":
        return out(*call(cfg, me, "GET", "/agents"))
    if a.cmd == "oracle":
        return out(*call(cfg, me, "POST", f"/problems/{a.pid}/oracle", load_json_arg(a.query)))
    if a.cmd == "eval":
        return out(*call(cfg, me, "POST", f"/problems/{a.pid}/eval", load_json_arg(a.file)))
    if a.cmd == "submit":
        return out(*call(cfg, me, "POST", f"/problems/{a.pid}/submit", {"submission": load_json_arg(a.file), "claim": a.claim}))
    if a.cmd == "publish":
        body = open(a.body_file).read() if a.body_file else a.body
        claims = []
        for c in a.claim:
            pid, eid, val = c.split(":", 2)
            claims.append({"problem": pid, "eval_id": eid, "value": float(val)})
        return out(*call(cfg, me, "POST", "/preprints", {"title": a.title, "body": body, "claims": claims, "cites": a.cite}))
    if a.cmd == "search":
        from urllib.parse import quote
        return out(*call(cfg, me, "GET", f"/preprints?qtext={quote(a.query)}"))
    if a.cmd == "read":
        return out(*call(cfg, me, "GET", f"/preprints/{a.id}"))
    if a.cmd == "post":
        return out(*call(cfg, me, "POST", "/board", {"text": a.text, "channel": a.channel}))
    if a.cmd == "inbox":
        cur = os.path.join(LAB, "cursors", me)
        since = 0 if a.all or not os.path.exists(cur) else int(open(cur).read() or 0)
        st, body = call(cfg, me, "GET", f"/board?since={since}")
        if st == 200:
            os.makedirs(os.path.dirname(cur), exist_ok=True)
            open(cur, "w").write(str(body["last_id"]))
        return out(st, body)
    if a.cmd in ("recruit", "spawn"):
        brief = open(a.brief_file).read() if a.brief_file else a.brief
        st, body = call(cfg, me, "POST", "/agents/spawn", {"role": a.role, "brief": brief})
        if st == 200:
            aid = body["agent_id"]
            os.makedirs(os.path.join(LAB, "logs"), exist_ok=True)
            log = open(os.path.join(LAB, "logs", f"{aid}.log"), "w")
            subprocess.Popen([sys.executable, KERNEL, "--agent-id", aid], stdout=log, stderr=subprocess.STDOUT,
                             env={**os.environ, "LAB_AGENT_ID": aid}, start_new_session=True)
        return out(st, body)
    if a.cmd == "datasets":
        return out(*call(cfg, me, "GET", "/datasets"))
    if a.cmd == "schema":
        return out(*call(cfg, me, "GET", "/schema"))
    if a.cmd == "put":
        st, body = put(cfg, me, a.path)
        return out(st, body)
    if a.cmd == "fetch":
        import base64
        st, body = call(cfg, me, "GET", f"/blobs/{a.blob}")
        if st == 200:
            with open(a.dest, "wb") as f:
                f.write(base64.b64decode(body["b64"]))
            body = {"blob": a.blob, "saved": a.dest}
        return out(st, body)
    if a.cmd == "exec":
        cmd = " ".join(a.command[1:] if a.command[:1] == ["--"] else a.command)
        st, body = put(cfg, me, a.code)
        if st != 200:
            return out(st, body)
        inputs = dict(kv.split("=", 1) for kv in a.input)
        return out(*call(cfg, me, "POST", "/exec", {"code": body["blob"], "cmd": cmd, "inputs": inputs, "timeout": a.timeout},
                         timeout=a.timeout + 60))
    if a.cmd == "contribute":
        return out(*call(cfg, me, "POST", "/artifacts", load_json_arg(a.file)))
    if a.cmd == "artifacts":
        from urllib.parse import quote
        return out(*call(cfg, me, "GET", f"/artifacts?kind={quote(a.type)}&qtext={quote(a.query)}"))
    if a.cmd == "runs":
        return out(*call(cfg, me, "GET", f"/execs?mine={'0' if a.all else '1'}"))
    if a.cmd == "show":
        path = f"/exec/{a.id}" if a.id.startswith("exec-") else f"/artifacts/{a.id}"
        return out(*call(cfg, me, "GET", path))
    if a.cmd == "wait":
        def snapshot():
            _, b = call(cfg, me, "GET", "/board?since=0")
            _, ar = call(cfg, me, "GET", "/artifacts?limit=10000")
            return b.get("last_id", 0), len(ar.get("artifacts", []))
        start, t0 = snapshot(), time.time()
        while time.time() - t0 < min(a.seconds, 1800):
            time.sleep(10)
            now = snapshot()
            if now != start:
                return out(200, {"woke": True, "new_messages": now[0] != start[0], "new_artifacts": now[1] - start[1],
                                 "waited_s": round(time.time() - t0)})
        return out(200, {"woke": False, "waited_s": round(time.time() - t0)})
    if a.cmd == "done":
        return out(*call(cfg, me, "POST", "/agents/exit", {"note": a.note}))
    if a.cmd == "boot":
        if a.model and a.model != "{model}":
            st, body = call(cfg, "founder", "POST", "/run/model", {"model": a.model})
            print("model:", body, flush=True)
        return boot(cfg)
    return 1


def put(cfg, me, path):
    """Upload a file as-is, or a directory as a tar with fixed metadata (same code, same blob id)."""
    import base64
    import io
    import tarfile
    if os.path.isdir(path):
        buf = io.BytesIO()
        def norm(ti):
            ti.mtime, ti.uid, ti.gid, ti.uname, ti.gname = 0, 0, 0, "", ""
            return ti
        with tarfile.open(fileobj=buf, mode="w") as t:
            for name in sorted(os.listdir(path)):
                t.add(os.path.join(path, name), arcname=name, filter=norm)
        data = buf.getvalue()
    else:
        data = open(path, "rb").read()
    return call(cfg, me, "POST", "/blobs", {"b64": base64.b64encode(data).decode()})


def boot(cfg):
    """Founder runs in the foreground; then wait until every agent is done or time is up."""
    os.makedirs(os.path.join(LAB, "logs"), exist_ok=True)
    st, b = call(cfg, "founder", "GET", "/budget")
    deadline = time.time() + (b.get("seconds_left", 0) if st == 200 else 0) + 30
    subprocess.run([sys.executable, KERNEL, "--agent-id", "founder"])
    while time.time() < deadline and _live_kernels():
        time.sleep(10)
    return 0


def _live_kernels():
    """Every agent runs in this sandbox, so live kernel processes are the live community."""
    r = subprocess.run(["pgrep", "-f", "kernel.py --agent-id"], capture_output=True, text=True)
    return r.stdout.split()


if __name__ == "__main__":
    sys.exit(main())
